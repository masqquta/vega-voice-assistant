# Скопируйте в .env и заполните. .env не коммитится. Без ключей LLM работает слой RuleBased,
# поиск — в режиме FTS, голос — через браузерное распознавание (если браузер его умеет).
PORT=3000
NODE_ENV=development
DB_PATH=data/app.db
TZ_DEFAULT=Europe/Moscow

# OpenRouter — основная LLM (бесплатные модели, ключ без карты: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free

# YandexGPT, SpeechKit, эмбеддинги
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LLM_MODEL=yandexgpt/latest

# GigaChat — запасная LLM
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# STT: yandex | whisper
STT_PROVIDER=yandex
WHISPER_API_KEY=

LLM_TIMEOUT_MS=4000
RATE_LIMIT_PER_MIN=30
# 0 — не загружать демо-записи в пустую БД
SEED_DEMO=1
