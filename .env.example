# Скопируйте в .env и заполните. .env не коммитится. Без ключей LLM работает слой RuleBased,
# поиск — в режиме FTS, голос — через браузерное распознавание (если браузер его умеет).
PORT=3000
NODE_ENV=development
DB_PATH=data/app.db
TZ_DEFAULT=Europe/Moscow

# Groq — основная LLM (бесплатно, тысячи запросов в сутки, ключ без карты: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# OpenRouter — запасная LLM (бесплатные модели, ключ без карты: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free

# YandexGPT, SpeechKit, эмбеддинги
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LLM_MODEL=yandexgpt/latest

# GigaChat — запасная LLM
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# STT: yandex | whisper; пусто — Whisper на Groq, если задан GROQ_API_KEY
STT_PROVIDER=
WHISPER_API_KEY=

LLM_TIMEOUT_MS=4000
RATE_LIMIT_PER_MIN=30
# 0 — не загружать демо-записи в пустую БД
SEED_DEMO=1
